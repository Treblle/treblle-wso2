<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.treblle.wso2publisher.handlers</groupId>
    <artifactId>treblle-wso2</artifactId>
    <version>3.0.5</version>
    <packaging>bundle</packaging>

    <name>Custom API Log Handler</name>

    <dependencies>
        <!--
            apimgt dependency — provided: only APIMgtGatewayConstants is referenced, and
            that collapses to an inlined compile-time constant, so nothing is needed (or
            imported) from this artifact at runtime.
        -->
        <dependency>
            <groupId>org.wso2.carbon.apimgt</groupId>
            <artifactId>org.wso2.carbon.apimgt.gateway</artifactId>
            <version>${wso2.apim.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- synapse dependency -->
        <dependency>
            <groupId>org.apache.synapse</groupId>
            <artifactId>synapse-core</artifactId>
            <version>${wso2.synapse.version}</version>
            <scope>provided</scope>
        </dependency>

        <!--
            org.json is embedded into the bundle (see maven-bundle-plugin Embed-Dependency)
            so the handler never has to wire it from the WSO2 OSGi runtime, whose exported
            version drifts across APIM releases. Pinned explicitly for deterministic builds
            across every wso2am-* profile.
        -->
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <!--
                Pinned to a pre-multi-release build: later org.json jars ship a
                META-INF/versions/9/module-info.class that the legacy bnd in
                maven-bundle-plugin 3.0.1 cannot parse when embedding.
            -->
            <version>20190722</version>
        </dependency>

        <dependency>
            <groupId>org.wso2.carbon.apimgt</groupId>
            <artifactId>org.wso2.carbon.apimgt.impl</artifactId>
            <version>${wso2.apim.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.12</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <repositories>
        <repository>
            <id>wso2-nexus</id>
            <name>WSO2 internal Repository</name>
            <url>https://maven.wso2.org/nexus/content/groups/wso2-public/</url>
            <releases>
                <enabled>true</enabled>
                <updatePolicy>daily</updatePolicy>
                <checksumPolicy>ignore</checksumPolicy>
            </releases>
        </repository>
        <repository>
            <id>wso2.releases</id>
            <name>WSO2 internal Repository</name>
            <url>https://maven.wso2.org/nexus/content/repositories/releases/</url>
            <releases>
                <enabled>true</enabled>
                <updatePolicy>daily</updatePolicy>
                <checksumPolicy>ignore</checksumPolicy>
            </releases>
        </repository>

        <repository>
            <id>wso2.snapshots</id>
            <name>Apache Snapshot Repository</name>
            <url>https://maven.wso2.org/nexus/content/repositories/snapshots/</url>
            <snapshots>
                <enabled>true</enabled>
                <updatePolicy>daily</updatePolicy>
            </snapshots>
            <releases>
                <enabled>false</enabled>
            </releases>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>wso2-nexus</id>
            <name>WSO2 internal Repository</name>
            <url>https://maven.wso2.org/nexus/content/groups/wso2-public/</url>
            <releases>
                <enabled>true</enabled>
                <updatePolicy>daily</updatePolicy>
                <checksumPolicy>ignore</checksumPolicy>
            </releases>
        </pluginRepository>

        <pluginRepository>
            <id>wso2.releases</id>
            <name>WSO2 internal Repository</name>
            <url>https://maven.wso2.org/nexus/content/repositories/releases/</url>
            <releases>
                <enabled>true</enabled>
                <updatePolicy>daily</updatePolicy>
                <checksumPolicy>ignore</checksumPolicy>
            </releases>
        </pluginRepository>

        <pluginRepository>
            <id>wso2.snapshots</id>
            <name>WSO2 Snapshot Repository</name>
            <url>https://maven.wso2.org/nexus/content/repositories/snapshots/</url>
            <snapshots>
                <enabled>true</enabled>
                <updatePolicy>daily</updatePolicy>
            </snapshots>
            <releases>
                <enabled>false</enabled>
            </releases>
        </pluginRepository>
    </pluginRepositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>1.8</source>
                    <target>1.8</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.0.0-M7</version>
                <dependencies>
                    <dependency>
                        <groupId>org.junit.jupiter</groupId>
                        <artifactId>junit-jupiter-engine</artifactId>
                        <version>5.10.2</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <version>3.0.1</version>
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <Bundle-SymbolicName>treblle-wso2</Bundle-SymbolicName>
                        <Bundle-Name>treblle-wso2</Bundle-Name>
                        <!--
                            Export only the handler package (the one Synapse loads by class
                            name). The dto/commons packages and the embedded org.json stay
                            bundle-private so the export carries no uses-constraint on the
                            embedded copy of org.json.
                        -->
                        <Export-Package>
                            com.treblle.wso2publisher.handlers
                        </Export-Package>
                        <!--
                            Embed org.json as a nested jar on the Bundle-ClassPath so its
                            classes live inside this bundle and are never wired from the
                            runtime. Nested (not inlined) because the legacy bnd in
                            maven-bundle-plugin 3.0.1 cannot parse org.json's multi-release
                            module-info.class when unpacking.
                        -->
                        <Embed-Dependency>json;groupId=org.json;inline=false</Embed-Dependency>
                        <Embed-Transitive>false</Embed-Transitive>
                        <!--
                            Require the WSO2 platform packages the handler genuinely needs so
                            a real incompatibility fails LOUDLY at deploy time instead of
                            silently (the previous blanket resolution:=optional turned a
                            missing/mismatched package into a runtime NoClassDefFoundError).
                            Everything else stays optional.
                        -->
                        <Import-Package>
                            org.apache.synapse.*,
                            org.apache.axis2.*,
                            org.apache.axiom.*,
                            org.apache.http.*,
                            org.apache.commons.logging;version="[1.2,2)",
                            *; resolution:=optional
                        </Import-Package>
                    </instructions>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <!-- Default to WSO2 APIM 4.3.x versions -->
        <wso2.apim.version>9.32.167</wso2.apim.version>
        <wso2.synapse.version>4.0.0-wso2v105</wso2.synapse.version>
        <wso2.version.suffix>4.3.x</wso2.version.suffix>
    </properties>

    <profiles>
        <!-- Profile for WSO2 API Manager 4.0.x -->
        <profile>
            <id>wso2am-4.0</id>
            <properties>
                <wso2.apim.version>9.0.0</wso2.apim.version>
                <wso2.synapse.version>4.0.0-wso2v100</wso2.synapse.version>
                <wso2.version.suffix>4.0.x</wso2.version.suffix>
            </properties>
            <build>
                <finalName>treblle-wso2-${project.version}</finalName>
            </build>
        </profile>

        <!-- Profile for WSO2 API Manager 4.1.x -->
        <profile>
            <id>wso2am-4.1</id>
            <properties>
                <wso2.apim.version>9.1.0</wso2.apim.version>
                <wso2.synapse.version>4.0.0-wso2v102</wso2.synapse.version>
                <wso2.version.suffix>4.1.x</wso2.version.suffix>
            </properties>
            <build>
                <finalName>treblle-wso2-${project.version}</finalName>
            </build>
        </profile>

        <!-- Profile for WSO2 API Manager 4.2.x -->
        <profile>
            <id>wso2am-4.2</id>
            <properties>
                <wso2.apim.version>9.2.0</wso2.apim.version>
                <wso2.synapse.version>4.0.0-wso2v103</wso2.synapse.version>
                <wso2.version.suffix>4.2.x</wso2.version.suffix>
            </properties>
            <build>
                <finalName>treblle-wso2-${project.version}</finalName>
            </build>
        </profile>

        <!-- Profile for WSO2 API Manager 4.3.x (default) -->
        <profile>
            <id>wso2am-4.3</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <wso2.apim.version>9.29.120</wso2.apim.version>
                <wso2.synapse.version>4.0.0-wso2v105</wso2.synapse.version>
                <wso2.version.suffix>4.3.x</wso2.version.suffix>
            </properties>
            <build>
                <finalName>treblle-wso2-${project.version}</finalName>
            </build>
        </profile>

        <!-- Profile for WSO2 API Manager 4.4.x -->
        <profile>
            <id>wso2am-4.4</id>
            <properties>
                <wso2.apim.version>9.31.0</wso2.apim.version>
                <wso2.synapse.version>4.0.0-wso2v106</wso2.synapse.version>
                <wso2.version.suffix>4.4.x</wso2.version.suffix>
            </properties>
            <build>
                <finalName>treblle-wso2-${project.version}</finalName>
            </build>
        </profile>

        <!-- Profile for WSO2 API Manager 4.6.x -->
        <profile>
            <id>wso2am-4.6</id>
            <properties>
                <wso2.apim.version>9.32.147</wso2.apim.version>
                <wso2.synapse.version>4.0.0-wso2v262</wso2.synapse.version>
                <wso2.version.suffix>4.6.x</wso2.version.suffix>
            </properties>
            <build>
                <finalName>treblle-wso2-${project.version}</finalName>
            </build>
        </profile>
    </profiles>

</project>